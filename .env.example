# Application Environment Configuration Example
# Copy this file to .env and populate with your own credentials

APP_ENV=development
LOG_LEVEL=INFO
APP_TITLE="Next-Best-Offer & Product Recommendation API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="High-throughput Next-Best-Offer and Product Recommendation System with Deterministic Operational & Supply Constraints"
API_PREFIX=/api/v1

# Neon PostgreSQL Database Connection URL
# Format: postgresql+psycopg://username:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Model Artifact Path
MODEL_ARTIFACT_PATH=models/nbo_propensity_best_model.joblib

# Optional read-only business assistant. Keep keys server-side.
ASSISTANT_PROVIDER=none
ASSISTANT_MODEL=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional checkpoint-backed Laya decision layer.
LAYA_ENABLED=false
LAYA_CACHE_DIR=F:\Next-Best-Offer-and-Product-Recommendation-with-Supply-Constraints\.laya-cache
