# Application Environment Configuration Example
# Copy this file to .env and populate with your own credentials

APP_ENV=development
LOG_LEVEL=INFO
APP_TITLE="Next-Best-Offer & Product Recommendation API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="High-throughput Next-Best-Offer and Product Recommendation System with Deterministic Operational & Supply Constraints"
API_PREFIX=/api/v1

# Neon PostgreSQL Database Connection URL
# Format: postgresql+psycopg://username:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Model Artifact Path
MODEL_ARTIFACT_PATH=models/nbo_propensity_best_model.joblib

# Optional Groq business assistant. Keep keys server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Execution Environment:
#   APP_ENV=local      -> Laya enabled by default (requires >= 2.5 GB RAM)
#   APP_ENV=aws        -> Full AWS production mode with Laya enabled + optional startup preload
#   APP_ENV=production -> Render Free 512 MB backup mode; uses WeightedDecisionEngine fallback unless LAYA_ENABLED=true
APP_ENV=local

# Laya Primary Decision Layer (lazy singleton, CPU, bounded candidate shortlist)
LAYA_ENABLED=true
LAYA_PRELOAD_ON_STARTUP=false
LAYA_MODEL=english
LAYA_DEVICE=cpu
LAYA_CPU_BFLOAT16=false
LAYA_MAX_CANDIDATES=5
LAYA_THREADS=0
LAYA_TIMEOUT_SECONDS=45
LAYA_CACHE_DIR=.laya-cache

# Deterministic Weighted Decision Fallback (when Laya is unavailable or invalid)
DECISION_ENGINE_ENABLED=true
DECISION_WEIGHT_RELEVANCE=0.45
DECISION_WEIGHT_MARGIN=0.25
DECISION_WEIGHT_DIVERSITY=0.15
DECISION_WEIGHT_FRICTION=0.15
