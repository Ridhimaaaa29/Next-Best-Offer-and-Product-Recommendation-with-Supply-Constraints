# AWS Full-Featured Deployment Environment Template (Independent from Render Backup)
# Copy to .env on the AWS EC2 host and inject real DATABASE_URL and GROQ_API_KEY securely.

APP_ENV=aws
LOG_LEVEL=INFO
APP_TITLE="Next-Best-Offer & Product Recommendation API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="High-throughput Next-Best-Offer and Product Recommendation System with Deterministic Operational & Supply Constraints"
API_PREFIX=/api/v1

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Gradient Boosting Propensity Artifact
MODEL_ARTIFACT_PATH=models/nbo_propensity_best_model.joblib
USE_ML_SCORING=true

# Groq Decision Assistant (optional; keep server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Full Laya Primary Decision Layer (enabled + warmed once on startup)
LAYA_ENABLED=true
LAYA_PRELOAD_ON_STARTUP=true
LAYA_MODEL=english
LAYA_DEVICE=cpu
LAYA_CPU_BFLOAT16=false
LAYA_MAX_CANDIDATES=5
LAYA_THREADS=0
LAYA_TIMEOUT_SECONDS=45
LAYA_CACHE_DIR=/app/.laya-cache
HF_HOME=/app/.laya-cache

# Deterministic Weighted Decision Engine (explicitly recorded fallback only)
DECISION_ENGINE_ENABLED=true
DECISION_WEIGHT_RELEVANCE=0.45
DECISION_WEIGHT_MARGIN=0.25
DECISION_WEIGHT_DIVERSITY=0.15
DECISION_WEIGHT_FRICTION=0.15

# Frontend Service Connection & Timeouts
API_BASE_URL=http://backend:8000/api/v1
API_TIMEOUT_SECONDS=15
RECOMMEND_TIMEOUT_SECONDS=90
